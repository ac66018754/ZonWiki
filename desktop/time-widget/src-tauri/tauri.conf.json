{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZonWiki Time Widget",
  "version": "0.1.0",
  "identifier": "com.zonwiki.time-widget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZonWiki 時間追蹤",
        "width": 520,
        "height": 380,
        "minWidth": 380,
        "minHeight": 240,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
